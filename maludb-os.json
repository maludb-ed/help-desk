{
  "schema": "maludb-os.application/1",
  "catalog_key": "helpdesk",
  "name": "Help Desk",
  "description": "The business's help desk: anyone — an employee, a customer with no OS account, an OS agent — files an issue or a request, and people and agents work it to a resolution. Queues per department, statuses with allowed transitions, SLA clocks, a board, canned responses, a knowledge base, email in and out, satisfaction surveys.",
  "business_area": "Everyday",
  "category": "other",
  "icon": "feather-life-buoy",
  "version": "0.1.0",
  "criticality": "high",
  "vhost": {
    "label": "helpdesk",
    "document_root": "html",
    "internal_port_env": "APP_INTERNAL_PORT"
  },
  "database": {
    "suffix": "helpdesk",
    "migrations": "db",
    "roles": {
      "rw": "helpdesk_rw",
      "records_ro": "helpdesk_records_ro",
      "activity_ro": "helpdesk_activity_ro"
    }
  },
  "env": {
    "required": [
      "APP_NAME",
      "APP_URL",
      "DB_HOST",
      "DB_PORT",
      "DB_NAME",
      "DB_USER",
      "DB_PASSWORD",
      "MCP_RECORDS_DB_USER",
      "MCP_RECORDS_DB_PASSWORD",
      "MCP_ACTIVITY_DB_USER",
      "MCP_ACTIVITY_DB_PASSWORD",
      "APP_INTERNAL_PORT",
      "MCP_RECORDS_PORT",
      "MCP_ACTIVITY_PORT",
      "ACTION_TOKEN_KEY",
      "ACTIONS_RELAY_KEY",
      "OS_APPLICATION_TOKEN",
      "OS_INTERNAL_URL",
      "OS_LAUNCHER_URL",
      "APP_KEY",
      "MALUDB_API_URL",
      "MALUDB_API_TOKEN"
    ],
    "optional": [
      "MALUMAIL_API_KEY",
      "MALUMAIL_API_URL",
      "MAIL_FROM",
      "MAIL_FROM_NAME",
      "ATTACHMENT_MAX_BYTES",
      "API_CORS_ORIGINS",
      "MALUMAIL_MCP_URL",
      "MAILBOX_SUPPORT_WEBHOOK_SECRET"
    ]
  },
  "services": [
    "deploy/helpdesk-records-mcp.service",
    "deploy/helpdesk-activity-mcp.service",
    "deploy/helpdesk-activity-ingest.service",
    "deploy/helpdesk-activity-ingest.timer",
    "deploy/helpdesk-directory-sync.service",
    "deploy/helpdesk-directory-sync.timer",
    "deploy/helpdesk-worker.service",
    "deploy/helpdesk-worker.timer"
  ],
  "endpoints": [
    {
      "name": "Records MCP",
      "kind": "mcp",
      "path": "/mcp/records",
      "port_env": "MCP_RECORDS_PORT",
      "auth_kind": "bearer",
      "agent_reachable": true,
      "mcp_surface_version": "1.0"
    },
    {
      "name": "Activity MCP",
      "kind": "mcp",
      "path": "/mcp/activity",
      "port_env": "MCP_ACTIVITY_PORT",
      "auth_kind": "bearer",
      "agent_reachable": true,
      "mcp_surface_version": "1.0"
    },
    {
      "name": "Web UI",
      "kind": "ui",
      "path": "/",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Health",
      "kind": "http_api",
      "path": "/api/v1/health",
      "auth_kind": "none",
      "agent_reachable": false
    }
  ],
  "actions": {
    "manifest": "docs/helpdesk-action-manifest.md",
    "registry": "mcp/action_registry.json",
    "base_url_env": "APP_INTERNAL_PORT"
  },
  "skills": [
    "skills/helpdesk-basics",
    "skills/ticket-lifecycle",
    "skills/writing-to-requesters",
    "skills/triage-the-queue",
    "skills/answer-from-the-knowledge-base",
    "skills/end-of-day-review"
  ],
  "sso": {
    "path": "/sso",
    "logout_path": "/sso/logout"
  },
  "directory": {
    "reads": true,
    "writes": false
  },
  "assistant": {
    "command_bar": true,
    "agent": "expert"
  },
  "agents": [
    {
      "key": "expert",
      "job_description": "os/expert.md",
      "access_capability": "write",
      "hired_on_install": true,
      "tool_grants": {
        "Records MCP": [
          "find_tickets",
          "get_ticket",
          "ticket_conversation",
          "ticket_transitions",
          "my_queue",
          "triage_queue",
          "sla_at_risk",
          "find_requesters",
          "requester_history",
          "similar_tickets",
          "search_canned_responses",
          "search_articles",
          "find_organizations",
          "ticket_counts",
          "get_vocabulary",
          "ticket_viewers",
          "find_members",
          "find_queues",
          "agent_workload",
          "stale_tickets",
          "find_views",
          "board_snapshot",
          "records_search"
        ],
        "Activity MCP": [
          "ticket_history",
          "actor_timeline",
          "who_touched",
          "activity_search"
        ],
        "Actions MCP": [
          "ticket_create",
          "ticket_reply",
          "ticket_note",
          "ticket_set_fields",
          "ticket_add_tags",
          "ticket_transition",
          "canned_apply",
          "ticket_follow"
        ]
      },
      "skills": [
        "skills/helpdesk-basics",
        "skills/ticket-lifecycle",
        "skills/writing-to-requesters"
      ]
    },
    {
      "key": "triage",
      "job_description": "os/triage.md",
      "access_capability": "write",
      "hired_on_install": true,
      "duty": {
        "name": "Triage the queue",
        "schedule_cron": "*/5 * * * *"
      },
      "tool_grants": {
        "Records MCP": [
          "triage_queue",
          "get_ticket",
          "ticket_conversation",
          "similar_tickets",
          "search_articles",
          "get_vocabulary",
          "find_members",
          "find_queues",
          "agent_workload",
          "requester_history",
          "find_organizations",
          "records_search"
        ],
        "Activity MCP": [
          "ticket_history"
        ],
        "Actions MCP": [
          "ticket_set_fields",
          "ticket_add_tags",
          "ticket_assign",
          "ticket_link",
          "ticket_note",
          "ticket_transition"
        ]
      },
      "skills": [
        "skills/helpdesk-basics",
        "skills/ticket-lifecycle",
        "skills/triage-the-queue"
      ]
    },
    {
      "key": "frontline",
      "job_description": "os/frontline.md",
      "access_capability": "write",
      "hired_on_install": true,
      "duty": {
        "name": "Work my queue",
        "schedule_cron": "*/10 * * * *"
      },
      "tool_grants": {
        "Records MCP": [
          "my_queue",
          "get_ticket",
          "ticket_conversation",
          "ticket_transitions",
          "search_articles",
          "search_canned_responses",
          "requester_history",
          "find_members",
          "find_queues",
          "get_vocabulary",
          "records_search"
        ],
        "Activity MCP": [
          "ticket_history"
        ],
        "Actions MCP": [
          "ticket_reply",
          "ticket_note",
          "ticket_transition",
          "ticket_assign",
          "canned_apply",
          "article_send"
        ]
      },
      "skills": [
        "skills/helpdesk-basics",
        "skills/ticket-lifecycle",
        "skills/writing-to-requesters",
        "skills/answer-from-the-knowledge-base"
      ]
    }
  ],
