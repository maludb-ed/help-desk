{
  "schema": "maludb-os.registry/1",
  "app_key": "helpdesk",
  "name": "Help Desk",
  "note": "The installer (bin/app_install.php, step 'registry') writes mcp/registries/helpdesk.json in the kernel from this file's `resolve` block plus mcp/action_registry.json. Each resolve tool answers a plain LIST of rows carrying id_field and label_field when given `q` alone. The tools are the Phase 1 tool surface's names; Phase 4 built them (mcp/records_server.py). A repeated param (tickets, cc) is a list of ids, never resolved by name.",
  "resolve": {
    "ticket": {
      "tool": "find_tickets",
      "query_param": "q",
      "id_field": "ticket_id",
      "label_field": "label",
      "params": [
        "ticket",
        "merge_into",
        "other_ticket"
      ]
    },
    "queue": {
      "tool": "find_queues",
      "query_param": "q",
      "id_field": "queue_id",
      "label_field": "name",
      "params": [
        "queue"
      ]
    },
    "member": {
      "tool": "find_members",
      "query_param": "q",
      "id_field": "member_id",
      "label_field": "display_name",
      "params": [
        "assignee",
        "member",
        "on_behalf_of"
      ]
    },
    "requester": {
      "tool": "find_requesters",
      "query_param": "q",
      "id_field": "requester_id",
      "label_field": "display_name",
      "params": [
        "requester"
      ]
    },
    "organization": {
      "tool": "find_organizations",
      "query_param": "q",
      "id_field": "organization_id",
      "label_field": "name",
      "params": [
        "organization"
      ]
    },
    "status": {
      "tool": "get_vocabulary",
      "query_param": "q",
      "id_field": "status_id",
      "label_field": "label",
      "params": [
        "status"
      ]
    },
    "category": {
      "tool": "get_vocabulary",
      "query_param": "q",
      "id_field": "category_id",
      "label_field": "path",
      "params": [
        "category"
      ]
    },
    "canned": {
      "tool": "search_canned_responses",
      "query_param": "q",
      "id_field": "canned_id",
      "label_field": "title",
      "params": [
        "canned"
      ]
    },
    "article": {
      "tool": "search_articles",
      "query_param": "q",
      "id_field": "article_id",
      "label_field": "title",
      "params": [
        "article"
      ]
    },
    "view": {
      "tool": "find_views",
      "query_param": "q",
      "id_field": "view_id",
      "label_field": "name",
      "params": [
        "view"
      ]
    },
    "type": {
      "tool": "get_vocabulary",
      "query_param": "q",
      "id_field": "type_id",
      "label_field": "label",
      "params": [
        "type"
      ]
    },
    "policy": {
      "tool": "find_sla_policies",
      "query_param": "q",
      "id_field": "policy_id",
      "label_field": "name",
      "params": [
        "policy"
      ]
    },
    "rule": {
      "tool": "find_rules",
      "query_param": "q",
      "id_field": "rule_id",
      "label_field": "name",
      "params": [
        "rule"
      ]
    },
    "mailbox": {
      "tool": "find_mailboxes",
      "query_param": "q",
      "id_field": "mailbox_id",
      "label_field": "address",
      "params": [
        "mailbox"
      ]
    }
  }
}
